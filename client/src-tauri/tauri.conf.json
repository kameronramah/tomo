{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tomo",
  "version": "0.12.1",
  "identifier": "com.tomo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tomo",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "backgroundColor": "#0E0D10",
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "tomo",
    "shortDescription": "Le vocal pour jouer entre potes",
    "windows": {
      "nsis": { "languages": ["French"], "displayLanguageSelector": false, "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzMTg5ODlFQzk4RDgyRjYKUldUMmdvM0pucGdZTTg5S3RaYjJtM3lsdU54R2N0c1h6dUwzN2FkbUhESGs4U1VZdDVNLzNPcWQK",
      "endpoints": ["https://github.com/kameronramah/tomo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
