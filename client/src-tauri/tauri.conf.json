{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomo",
  "version": "0.3.0",
  "identifier": "com.tomo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tomo",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "backgroundColor": "#0E1014",
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
