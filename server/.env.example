# Copier ce fichier en .env puis remplir les valeurs. Ne JAMAIS committer .env.

# Domaines (ex. DuckDNS) pointant vers l'IP du VPS
API_DOMAIN=tomo-api.duckdns.org
LIVEKIT_DOMAIN=tomo-rtc.duckdns.org

# E-mail pour Let's Encrypt (avertissements d'expiration de certificat)
ACME_EMAIL=toi@example.com

# Clés LiveKit : docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL publique de LiveKit renvoyée aux clients
LIVEKIT_URL=wss://tomo-rtc.duckdns.org

# Secret de signature des sessions (48 caractères aléatoires minimum) :
#   openssl rand -base64 48
JWT_SECRET=

# open : tout le monde peut créer un compte ; closed : inscriptions fermées
REGISTRATION=open

# Recherche de GIF (Klipy, gratuit) : crée une clé sur https://partner.klipy.com
# Laisse vide pour désactiver la recherche (les GIF envoyés comme fichiers marchent quand même).
KLIPY_API_KEY=

# Stats de jeu (facultatif, gratuit). Sans clé, la liaison marche mais pas les stats.
# Steam : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Riot (League of Legends) : https://developer.riotgames.com — la clé « development » expire toutes
# les 24 h ; demande une clé « personal » (gratuite) pour un usage durable.
RIOT_API_KEY=

# ⚠️ Ne JAMAIS ajouter DEV_TOOLS ici : les outils de test sont réservés au serveur de dev local.
