# Copier ce fichier en .env puis remplir les valeurs. Ne JAMAIS committer .env.

# Domaines (ex. DuckDNS) pointant vers l'IP du VPS
API_DOMAIN=t2m-api.duckdns.org
LIVEKIT_DOMAIN=t2m-rtc.duckdns.org

# E-mail pour Let's Encrypt (avertissements d'expiration de certificat)
ACME_EMAIL=toi@example.com

# Clés LiveKit : docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL publique de LiveKit renvoyée aux clients
LIVEKIT_URL=wss://t2m-rtc.duckdns.org

# Code d'invitation à partager avec tes amis (choisis-en un long)
INVITE_CODE=

# Nom du serveur affiché dans l'appli
SERVER_NAME=Les potes

# Salons vocaux : identifiant:Nom affiché, séparés par des virgules
ROOMS=general:Général,jeux:Jeux,chill:Chill,afk:AFK
